CompileFlags:
  CompilationDatabase: "out/Release/build"

Completion:
  HeaderInsertion: Never

---
# Test and mock files are only given the Catch2 include paths and the MS_TEST
# define when `ms_build_tests` is enabled.
If:
  PathMatch: (test|mocks)/.*

CompileFlags:
  CompilationDatabase: "out/Release/build-test"

---
# Fuzzer files are only given the MS_FUZZER define when `ms_build_fuzzer` is
# enabled.
If:
  PathMatch: fuzzer/.*

CompileFlags:
  CompilationDatabase: "out/Release/build-fuzzer"
